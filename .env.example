# GEMINI_API_KEY: Google Gemini API (Free Tier available at aistudio.google.com)
# Provides up to 1,500 free requests/day with Gemini 3.7 Flash / 2.0 Flash.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Groq Cloud API (Free Tier available at console.groq.com)
# Provides ultra-fast inference with Llama 3.3 70B Versatile and DeepSeek R1.
GROQ_API_KEY=""

# OPENROUTER_API_KEY: OpenRouter API (Free models available at openrouter.ai)
# Gives access to Meta Llama 3.3 70B:free, DeepSeek R1:free, etc.
OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

