# GEMINI_API_KEY: Google Gemini API (server-side only via @google/genai)
# Provides Gemini 4 Flash support through /api/copilot/* routes.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Groq Cloud API (Free Tier available at console.groq.com)
# Provides ultra-fast inference with Llama 3.3 70B Versatile and DeepSeek R1.
GROQ_API_KEY=""

# OPENROUTER_API_KEY: OpenRouter API (Free models available at openrouter.ai)
# Gives access to Meta Llama 3.3 70B:free, DeepSeek R1:free, etc.
OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

